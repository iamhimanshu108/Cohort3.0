# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/access-refresh-token
ACCESS_TOKEN_SECRECT=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRECT=replace-with-a-different-long-random-refresh-secret

# Or use a MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
